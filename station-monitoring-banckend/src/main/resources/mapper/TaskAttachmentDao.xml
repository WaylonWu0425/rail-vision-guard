<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzy.sms.stationmonitoringbanckend.mapper.TaskAttachmentMapper">

    <resultMap type="com.zzy.sms.stationmonitoringbanckend.entity.TaskAttachment" id="TaskAttachmentMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="taskId" column="task_id" jdbcType="INTEGER"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="filePath" column="file_path" jdbcType="VARCHAR"/>
        <result property="uploadTime" column="upload_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!--查询任务的单个附件-->
    <select id="selectTaskAttachmentById" resultMap="TaskAttachmentMap">
        select
id, task_id, name, file_path, upload_time
        from task_attachment
        where id = #{id}
    </select>

    <!--查询任务所有附件-->
    <select id="selectAll" resultMap="TaskAttachmentMap">
        select
            id, task_id, name, file_path, upload_time
        from task_attachment
        where task_id = #{taskId}
    </select>


    <!--添加任务附件-->
    <insert id="insertTaskAttachment" keyProperty="id" useGeneratedKeys="true">
        insert into task_attachment(task_id, name, file_path, upload_time)
        values (#{taskId}, #{name}, #{filePath}, #{uploadTime})
    </insert>


    <!--通过主键删除-->
    <delete id="deleteById">
        delete from task_attachment where id = #{id}
    </delete>

</mapper>

