<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzy.sms.stationmonitoringbanckend.mapper.GunmachineCameraMapper">

    <resultMap type="com.zzy.sms.stationmonitoringbanckend.dto.GunmachineDTO" id="GunmachineDTOMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="cameraId" column="camera_id" jdbcType="INTEGER"/>
        <result property="cameraName" column="camera_name" jdbcType="VARCHAR"/>
        <result property="trackId" column="track_id" jdbcType="INTEGER"/>
        <result property="smallRange" column="small_range" jdbcType="INTEGER"/>
        <result property="wideRange" column="wide_range" jdbcType="INTEGER"/>
    </resultMap>

    <select id="getAllGunmachine" resultMap="GunmachineDTOMap">
        SELECT
            g.id,
            g.camera_id,
            c.name AS camera_name,
            g.track_id,
            g.small_range,
            g.wide_range
        FROM
            gunmachine g
                JOIN
            camera c ON g.camera_id = c.id
    </select>

    <select id="search" resultMap="GunmachineDTOMap">
        SELECT
        g.id,
        g.camera_id,
        c.name AS camera_name,
        g.track_id,
        g.small_range,
        g.wide_range
        FROM
        gunmachine g
        JOIN
        camera c ON g.camera_id = c.id
        <where>
            <if test="cameraId != null">
                and camera_id = #{cameraId}
            </if>
            <if test="trackId != null">
                and track_id = #{trackId}
            </if>
        </where>
    </select>
</mapper>

