# Copy to .env and load it into the current PowerShell session (see README).
# Spring Boot and the Python detection services share these MySQL settings.
DETECTION_DB_HOST=127.0.0.1
DETECTION_DB_PORT=3306
DETECTION_DB_NAME=station_monitoring
DETECTION_DB_USER=rail_app
DETECTION_DB_PASSWORD=

APP_REDIS_HOST=127.0.0.1
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=

# Optional. Required only for email verification or AI assistant, respectively.
APP_MAIL_HOST=smtp.qq.com
APP_MAIL_PORT=465
APP_MAIL_USERNAME=
APP_MAIL_PASSWORD=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional. Absolute path to an authorized local FFmpeg installation.
RAIL_FFMPEG_PATH=
